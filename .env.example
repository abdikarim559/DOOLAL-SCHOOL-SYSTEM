# ============================================================================
# Doolaal School Management System — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in environment-appropriate values.
# NEVER commit the real .env file or credentials to version control.
# ============================================================================

# Environment Mode (development, test, production)
# In production, strict configuration validation is enforced.
NODE_ENV=development

# Server HTTP Port (1-65535, default: 5000)
PORT=5000

# Server Listen Host (default: 0.0.0.0)
HOST=0.0.0.0

# Structured Logging Level (debug, info, warn, error)
# Production default is info. Debug is disabled by default in production.
LOG_LEVEL=info

# MongoDB Connection String (REQUIRED)
# Development:  mongodb://127.0.0.1:27017/school_management
# Production:   mongodb+srv://<db_user>:<db_pass>@cluster0.example.mongodb.net/school_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/school_management

# JWT Authentication Secret (REQUIRED)
# In production, must be at least 32 characters long.
# Generate a cryptographically secure key:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters

# CORS Allowed Frontend Origins (REQUIRED in production)
# Comma-separated list of approved origins (e.g. https://school.example.com)
# In development, localhost and 127.0.0.1 are automatically permitted.
# Wildcard '*' is strictly rejected in production.
FRONTEND_ORIGIN=http://localhost:5000

# SMTP Email Configuration (REQUIRED in production for OTP email delivery)
# If SMTP_HOST is blank in development, the system falls back to development email fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DOOLAL SCHOOL" <noreply@schoolsystem.com>

# Initial Bootstrap Admin Password
# Used ONLY on the very first startup if no admin account exists in the database.
# In development, if unset, a one-time random password is generated and logged once.
# In production, specify a strong initial password before the first run.
ADMIN_INIT_PASSWORD=
