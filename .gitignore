# -----------------------------------------------
# Doolaal School Management System — .gitignore
# -----------------------------------------------

# Environment variables — NEVER commit secrets
.env
.env.*
!.env.example
.env.local
.env.*.local

# Node.js dependencies
node_modules/

# Logs & temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
temp/

# Operating system files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Build output (if added later)
dist/
build/
